# Book manifest for md2latex.
# This file lives in the folder with the Markdown, and every path
# below is relative to this file. Reorder the chapters list to
# reorder the book; delete a line to leave that file out.

title:    "A Better Thought"
subtitle: "Finding Tranquility and Joy One Thought at a Time"
author:   "Bea Strickland"
date:     "2026"

# Where the generated LaTeX goes, relative to this file.
output:
  directory: ../latex
  main:      better-thought.tex
  chapters:  chapters

document:
  class:       book        # book | report | article
  toc:         true
  tocDepth:    2
  numberDepth: 2

dialect: markua

# How fenced code blocks are rendered: listings | minted | verbatim
code: listings

# Raw lines appended to the preamble, e.g.
# preamble:
#   - \usepackage{microtype}

# Chapters, in book order, relative to this file. Either a bare
# filename, or a mapping with 'file' plus an optional 'title' that
# overrides the H1. A mapping with 'part' inserts a part divider
# and reads no file. A file outside this folder is fine too, e.g.
#   - ../shared/preface.md
frontMatter:
  - "front-matter.md"   # What’s a Better Thought?
  - "introduction.md"   # Introduction
chapters:
  - "chapter-01.md"   # Chapter One
  - "chapter-02.md"   # Chapter 2
  - "chapter-03.md"   # Chapter 3: Better Thoughts in the Morning
  - "chapter-04.md"   # Chapter 4: Negativity Bias
  - "chapter-05.md"   # Chapter 5: Thinking About The Three Principles
  - "chapter-06.md"   # Chapter 6: Better Thoughts Through Better Beliefs
  - "chapter-07.md"   # Chapter 7: Action Through Choices
  - "chapter-08.md"   # Chapter 8: My Manifesto of Being Happy
  - "chapter-09.md"   # Chapter 9: Who Is Doing and Being?
  - "chapter-10.md"   # Chapter 10: We Need Others
  - "chapter-11.md"   # Chapter 11: Friendship and Conversation
  - "chapter-12.md"   # Chapter 12:  Love is the Best Thought of All
  - "chapter-13.md"   # Chapter 13: SPIRITUALITY
  - "chapter-14.md"   # Last Chapter: Better Thoughts Begin with Better Questions
appendices:
  - "appendix-1.md"   # APPENDIX 1
  - "appendix-2.md"   # APPENDIX 2: A Better Thought
